{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "typeRoots": ["./src/types", "./node_modules/@types"],
        "ignoreDeprecations": "6.0"
    },
    "ts-node": {
        "files": true
    },
    "include": [
        "src/**/*"
    ]
}