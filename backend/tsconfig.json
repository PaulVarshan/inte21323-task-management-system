{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*"
    ]
}